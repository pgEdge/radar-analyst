---
// App bar: logo, divider, product name, theme toggle. The toggle
// cycles system, light, dark and shows one Material icon per state.
---

<header class="pg-header">
  <a href="/" class="pg-header__brand" aria-label="Home">
    <img
      class="pg-header__logo pg-header__logo--light"
      src="/assets/pgedge-logo.svg"
      alt="pgEdge"
      width="112"
      height="28"
    />
    <img
      class="pg-header__logo pg-header__logo--dark"
      src="/assets/pgedge-logo-white.png"
      alt="pgEdge"
      width="112"
      height="28"
    />
    <span class="pg-header__divider" aria-hidden="true"></span>
    <span class="pg-header__title">Radar Analyst</span>
  </a>
  <button
    id="pg-theme-toggle"
    class="pg-icon-button"
    type="button"
    aria-label="Theme: follows the system. Switch to light."
    title="Theme: system"
  >
    <svg
      class="pg-header__icon"
      data-theme-state="system"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M10.85 12.65h2.3L12 9l-1.15 3.65zM20 8.69V4h-4.69L12 .69 8.69 4H4v4.69L.69 12 4 15.31V20h4.69L12 23.31 15.31 20H20v-4.69L23.31 12 20 8.69zM14.3 16l-.7-2h-3.2l-.7 2H7.8L11 7h2l3.2 9h-1.9z"></path>
    </svg>
    <svg
      class="pg-header__icon"
      data-theme-state="light"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M12,7c-2.76,0-5,2.24-5,5s2.24,5,5,5s5-2.24,5-5S14.76,7,12,7L12,7z M2,13l2,0c0.55,0,1-0.45,1-1s-0.45-1-1-1l-2,0 c-0.55,0-1,0.45-1,1S1.45,13,2,13z M20,13l2,0c0.55,0,1-0.45,1-1s-0.45-1-1-1l-2,0c-0.55,0-1,0.45-1,1S19.45,13,20,13z M11,2v2 c0,0.55,0.45,1,1,1s1-0.45,1-1V2c0-0.55-0.45-1-1-1S11,1.45,11,2z M11,20v2c0,0.55,0.45,1,1,1s1-0.45,1-1v-2c0-0.55-0.45-1-1-1 C11.45,19,11,19.45,11,20z M5.99,4.58c-0.39-0.39-1.03-0.39-1.41,0c-0.39,0.39-0.39,1.03,0,1.41l1.06,1.06 c0.39,0.39,1.03,0.39,1.41,0s0.39-1.03,0-1.41L5.99,4.58z M18.36,16.95c-0.39-0.39-1.03-0.39-1.41,0c-0.39,0.39-0.39,1.03,0,1.41 l1.06,1.06c0.39,0.39,1.03,0.39,1.41,0c0.39-0.39,0.39-1.03,0-1.41L18.36,16.95z M19.42,5.99c0.39-0.39,0.39-1.03,0-1.41 c-0.39-0.39-1.03-0.39-1.41,0l-1.06,1.06c-0.39,0.39-0.39,1.03,0,1.41s1.03,0.39,1.41,0L19.42,5.99z M7.05,18.36 c0.39-0.39,0.39-1.03,0-1.41c-0.39-0.39-1.03-0.39-1.41,0l-1.06,1.06c-0.39,0.39-0.39,1.03,0,1.41s1.03,0.39,1.41,0L7.05,18.36z"></path>
    </svg>
    <svg
      class="pg-header__icon"
      data-theme-state="dark"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M12,3c-4.97,0-9,4.03-9,9s4.03,9,9,9s9-4.03,9-9c0-0.46-0.04-0.92-0.1-1.36c-0.98,1.37-2.58,2.26-4.4,2.26 c-2.98,0-5.4-2.42-5.4-5.4c0-1.81,0.89-3.42,2.26-4.4C12.92,3.04,12.46,3,12,3L12,3z"></path>
    </svg>
  </button>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('pg-theme-toggle');
    if (!btn || !window.pgTheme) return;
    var icons = btn.querySelectorAll('.pg-header__icon');
    var NEXT = { system: 'light', light: 'dark', dark: 'system' };
    var WORDS = {
      system: 'follows the system',
      light: 'light',
      dark: 'dark',
    };
    function render() {
      var s = window.pgTheme.stored();
      for (var i = 0; i < icons.length; i++) {
        var on = icons[i].getAttribute('data-theme-state') === s;
        icons[i].classList.toggle('is-active', on);
      }
      btn.setAttribute(
        'aria-label',
        'Theme: ' + WORDS[s] + '. Switch to ' + WORDS[NEXT[s]] + '.',
      );
      btn.setAttribute('title', 'Theme: ' + s);
    }
    btn.addEventListener('click', window.pgTheme.cycle);
    document.addEventListener('pg-theme-change', render);
    render();
  })();
</script>

<style>
  .pg-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    padding: 0 1.5rem;
    background: var(--pg-bg-surface);
    border-bottom: 1px solid var(--pg-divider);
  }
  .pg-header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--pg-text);
    text-decoration: none;
  }
  .pg-header__brand:hover {
    text-decoration: none;
  }
  .pg-header__logo {
    display: block;
    height: 28px;
    width: auto;
  }
  .pg-header__logo--dark {
    display: none;
  }
  :root[data-theme='dark'] .pg-header__logo--light {
    display: none;
  }
  :root[data-theme='dark'] .pg-header__logo--dark {
    display: block;
  }
  .pg-header__divider {
    width: 1px;
    height: 1.5rem;
    background: var(--pg-input-border);
  }
  :root[data-theme='dark'] .pg-header__divider {
    background: var(--pg-border-strong);
  }
  .pg-header__title {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pg-header__icon {
    display: none;
  }
  .pg-header__icon.is-active {
    display: block;
  }
</style>
