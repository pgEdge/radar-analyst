---
// Drag-drop or click-to-pick upload form. Shows how much of the
// archive has been sent while the upload runs, then redirects to
// /live for the progress of the assessment itself.
---

<section class="pg-card pg-upload">
  <h2 class="pg-upload__title">Upload a radar archive</h2>
  <p class="pg-text-muted pg-upload__hint">
    Drag a <code class="pg-mono">radar-*.zip</code> here, or click to pick
    one. The analyst reads the archive, checks it against deterministic rules,
    and returns a verdict and a brief for every category.
  </p>

  <form id="pg-upload-form" class="pg-upload__form">
    <label class="pg-upload__drop" id="pg-upload-drop">
      <input
        id="pg-upload-file"
        type="file"
        name="file"
        accept=".zip,application/zip"
        required
        hidden
      />
      <span id="pg-upload-label">Choose a file or drop it here</span>
    </label>
    <div class="pg-upload__progress" id="pg-upload-progress-row" hidden>
      <progress id="pg-upload-progress" max="100" value="0"></progress>
      <span id="pg-upload-status" class="pg-text-muted"></span>
    </div>
    <div class="pg-upload__actions">
      <button
        id="pg-upload-submit"
        type="submit"
        class="pg-button"
        disabled
      >
        Upload
      </button>
      <span id="pg-upload-error" class="pg-upload__error"></span>
    </div>
  </form>
</section>

<script>
  import { api } from '../lib/api';

  const form = document.getElementById(
    'pg-upload-form',
  ) as HTMLFormElement | null;
  const input = document.getElementById(
    'pg-upload-file',
  ) as HTMLInputElement | null;
  const drop = document.getElementById('pg-upload-drop');
  const label = document.getElementById('pg-upload-label');
  const submit = document.getElementById(
    'pg-upload-submit',
  ) as HTMLButtonElement | null;
  const error = document.getElementById('pg-upload-error');
  const row = document.getElementById('pg-upload-progress-row');
  const bar = document.getElementById(
    'pg-upload-progress',
  ) as HTMLProgressElement | null;
  const status = document.getElementById('pg-upload-status');

  if (
    form &&
    input &&
    drop &&
    label &&
    submit &&
    error &&
    row &&
    bar &&
    status
  ) {
    const setFile = (file: File | undefined): void => {
      if (!file) {
        label.textContent = 'Choose a file or drop it here';
        submit.disabled = true;
        return;
      }
      label.textContent = `${file.name} (${Math.round(file.size / 1024)} KB)`;
      submit.disabled = false;
    };

    const showProgress = (fraction: number): void => {
      const pct = Math.round(fraction * 100);
      bar.value = pct;
      status.textContent = `Uploading… ${pct}%`;
    };

    input.addEventListener('change', () => {
      setFile(input.files?.[0]);
    });

    drop.addEventListener('dragover', (e) => {
      e.preventDefault();
      drop.classList.add('is-dragover');
    });
    drop.addEventListener('dragleave', () => {
      drop.classList.remove('is-dragover');
    });
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('is-dragover');
      const files = e.dataTransfer?.files;
      if (files && files[0]) {
        input.files = files;
        setFile(files[0]);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const file = input.files?.[0];
      if (!file) return;
      error.textContent = '';
      submit.disabled = true;
      submit.textContent = 'Uploading…';
      row.hidden = false;
      showProgress(0);
      try {
        const receipt = await api.postUpload(file, showProgress);
        status.textContent = 'Uploaded. Starting the assessment…';
        window.location.href =
          `/live?upload=${receipt.upload_id}` +
          `&job=${receipt.job_id}`;
      } catch (err) {
        error.textContent =
          err instanceof Error ? err.message : String(err);
        submit.disabled = false;
        submit.textContent = 'Upload';
        row.hidden = true;
      }
    });
  }
</script>

<style>
  .pg-upload {
    padding: 1.5rem;
  }
  .pg-upload__title {
    margin-top: 0;
    font-size: 1.375rem;
    font-weight: 600;
  }
  .pg-upload__hint {
    margin: 0 0 1.25rem 0;
  }
  .pg-upload__form {
    display: grid;
    gap: 1rem;
  }

  .pg-upload__drop {
    display: block;
    padding: 2rem 1rem;
    border: 2px dashed var(--pg-divider);
    border-radius: var(--pg-radius-card);
    text-align: center;
    cursor: pointer;
    color: var(--pg-text-muted);
    background: transparent;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
    word-break: break-word;
  }
  @media (max-width: 600px) {
    .pg-upload {
      padding: 1rem;
    }
    .pg-upload__drop {
      padding: 1.5rem 0.75rem;
    }
  }
  .pg-upload__drop:hover,
  .pg-upload__drop.is-dragover {
    border-color: var(--pg-primary);
    background: rgba(21, 170, 191, 0.06);
    color: var(--pg-text);
  }

  .pg-upload__progress {
    display: grid;
    gap: 0.375rem;
  }
  .pg-upload__progress progress {
    width: 100%;
    height: 0.5rem;
    accent-color: var(--pg-primary);
  }
  .pg-upload__progress span {
    font-size: 0.95rem;
  }

  .pg-upload__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .pg-upload__error {
    color: var(--pg-status-critical-fg);
    font-size: 0.95rem;
  }
</style>
