---
// Prior uploads table. Hydrated client-side from GET /api/uploads.
---

<section class="pg-card pg-uploads-list">
  <h2 class="pg-uploads-list__title">Prior uploads</h2>
  <div class="pg-uploads-list__scroller">
    <table class="pg-uploads-list__table" id="pg-uploads-table">
      <thead>
        <tr>
          <th>Uploaded</th>
          <th class="pg-col-hostname">Hostname</th>
          <th>Filename</th>
          <th class="pg-col-size">Size</th>
          <th aria-label="Actions"></th>
        </tr>
      </thead>
      <tbody id="pg-uploads-tbody">
        <tr><td colspan="5" class="pg-text-muted">Loading…</td></tr>
      </tbody>
    </table>
  </div>
</section>

<script is:inline>
  (function () {
    var tbody = document.getElementById('pg-uploads-tbody');
    if (!tbody) return;

    function kb(n) {
      if (n < 1024) return n + ' B';
      if (n < 1024 * 1024) return Math.round(n / 1024) + ' KB';
      return (n / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function fmt(iso) {
      try {
        return new Date(iso).toLocaleString();
      } catch (_) {
        return iso;
      }
    }

    fetch('/api/uploads?limit=50', {
      headers: { Accept: 'application/json' },
    })
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (body) {
        var items = body.items || [];
        if (!items.length) {
          tbody.innerHTML =
            '<tr><td colspan="5" class="pg-text-muted">' +
            'No uploads yet.</td></tr>';
          return;
        }
        tbody.innerHTML = items
          .map(function (u) {
            var host = u.hostname || '-';
            return (
              '<tr>' +
              '<td>' +
              fmt(u.created_at) +
              '</td>' +
              '<td class="pg-mono pg-col-hostname">' +
              host +
              '</td>' +
              '<td class="pg-uploads-list__filename">' +
              u.filename +
              '</td>' +
              '<td class="pg-col-size">' +
              kb(u.size_bytes) +
              '</td>' +
              '<td>' +
              '<a href="/upload?id=' +
              u.id +
              '">' +
              'Open➡️</a> ' +
              '<button class="pg-btn-delete" ' +
              'data-upload-id="' +
              u.id +
              '" ' +
              'title="Delete upload" ' +
              'aria-label="Delete upload">❌</button>' +
              '</td>' +
              '</tr>'
            );
          })
          .join('');
      })
      .then(function () {
        // Wire up delete buttons after rows are rendered.
        // DELETE requires Authorization: Bearer <admin-token>.
        // Token lives in sessionStorage (per-tab); user is
        // prompted on first delete and re-prompted on 401.
        var TOKEN_KEY = 'radar_analyst_admin_token';

        function getToken(force) {
          var t = !force && sessionStorage.getItem(TOKEN_KEY);
          if (t) return t;
          var entered = window.prompt(
            'Admin token (RADAR_ANALYST_ADMIN_TOKEN):',
          );
          if (entered) sessionStorage.setItem(TOKEN_KEY, entered);
          return entered;
        }

        tbody.addEventListener('click', function (ev) {
          var btn = ev.target.closest('.pg-btn-delete');
          if (!btn) return;
          var uid = btn.getAttribute('data-upload-id');
          if (!uid) return;
          if (!confirm('Delete this upload?')) return;
          var token = getToken(false);
          if (!token) return;
          btn.disabled = true;
          btn.textContent = '...';
          fetch('/api/uploads/' + uid, {
            method: 'DELETE',
            headers: { Authorization: 'Bearer ' + token },
          })
            .then(function (r) {
              if (r.ok) {
                var row = btn.closest('tr');
                if (row) row.remove();
                return;
              }
              if (r.status === 401) {
                sessionStorage.removeItem(TOKEN_KEY);
                alert('Auth failed - token cleared, try again.');
              } else if (r.status === 503) {
                alert(
                  'Server admin auth not configured ' +
                    '(RADAR_ANALYST_ADMIN_TOKEN unset).',
                );
              } else {
                alert('Delete failed: HTTP ' + r.status);
              }
              btn.disabled = false;
              btn.textContent = '\u274C';
            })
            .catch(function () {
              alert('Delete failed');
              btn.disabled = false;
              btn.textContent = '\u274C';
            });
        });
      })
      .catch(function (e) {
        tbody.innerHTML =
          '<tr><td colspan="5" class="pg-text-muted">' +
          'Failed to load: ' +
          String(e.message || e) +
          '</td></tr>';
      });
  })();
</script>

<style>
  .pg-uploads-list {
    padding: 1.5rem;
  }
  .pg-uploads-list__title {
    margin-top: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }
  /* Belt-and-braces: if a row ever exceeds the card width despite
   * the wrap rules below, scroll inside the card instead of pushing
   * the whole page off-viewport. */
  .pg-uploads-list__scroller {
    overflow-x: auto;
  }
  .pg-uploads-list__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .pg-uploads-list__table th,
  .pg-uploads-list__table td {
    text-align: left;
    padding: 0.625rem 0.5rem;
    border-bottom: 1px solid var(--pg-divider);
  }
  .pg-uploads-list__table th {
    font-weight: 600;
    color: var(--pg-text-muted);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pg-uploads-list__table td:last-child {
    text-align: right;
    white-space: nowrap;
  }
  /* Rules below target JS-injected <td>s, which never get
   * Astro's scope hash. Use :global() so they actually match. */
  :global(.pg-uploads-list__filename) {
    word-break: break-all;
  }
  /* On narrow viewports, drop the rarely-meaningful Hostname and
   * Size columns so the timestamp + filename + actions fit
   * without horizontal scroll. */
  @media (max-width: 600px) {
    .pg-uploads-list {
      padding: 1rem;
    }
    .pg-uploads-list__table {
      font-size: 0.9rem;
    }
    .pg-uploads-list__table th,
    .pg-uploads-list__table td {
      padding: 0.5rem 0.375rem;
    }
    :global(.pg-col-hostname),
    :global(.pg-col-size) {
      display: none;
    }
  }
  /* Delete button: a bare ❌ emoji. The colour comes from the
   * emoji glyph itself; no border / background: just a click
   * target. :global() so the dynamically-rendered button matches. */
  :global(.pg-btn-delete) {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0.2rem 0.4rem;
    margin-left: 0.25rem;
    vertical-align: middle;
  }
  :global(.pg-btn-delete:hover) {
    filter: brightness(1.1);
  }
  :global(.pg-btn-delete:disabled) {
    opacity: 0.5;
    cursor: progress;
  }
</style>
