---
// Per-upload header: system identity, hardware, container / cloud
// context, PostgreSQL version. Hydrated from /api/uploads/{id} and
// /api/uploads/{id}/snapshot.
---

<section class="pg-card pg-snapshot" id="pg-snapshot">
  <div id="pg-snapshot-body">
    <p class="pg-text-muted">Loading snapshot…</p>
  </div>
</section>

<script is:inline>
  (function () {
    var body = document.getElementById('pg-snapshot-body');
    if (!body) return;
    var id = new URLSearchParams(window.location.search).get('id');
    if (!id) return;

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] || c;
      });
    }

    function row(label, valueHtml) {
      return (
        '<div class="pg-kv__row">' +
        '<dt class="pg-kv__label">' +
        esc(label) +
        '</dt>' +
        '<dd class="pg-kv__value">' +
        valueHtml +
        '</dd>' +
        '</div>'
      );
    }

    Promise.all([
      fetch('/api/uploads/' + id).then(function (r) {
        return r.ok ? r.json() : Promise.reject(r.status);
      }),
      fetch('/api/uploads/' + id + '/snapshot').then(function (r) {
        return r.ok ? r.json() : null;
      }),
    ])
      .then(function (data) {
        var u = data[0];
        var s = data[1] || {};
        var filenameHost = null;
        var m = /^radar-(.+?)-\d{8}-\d{6}\.zip$/.exec(u.filename || '');
        if (m) filenameHost = m[1];
        var hostname =
          s.hostname ||
          u.hostname ||
          filenameHost ||
          u.filename ||
          'host';
        var uploadedAt = new Date(u.created_at).toLocaleString();

        var osParts = [];
        if (s.os) osParts.push(esc(s.os));
        if (s.kernel)
          osParts.push(
            'kernel <span class="pg-mono">' + esc(s.kernel) + '</span>',
          );
        var osLine = osParts.length
          ? osParts.join(' · ')
          : '<span class="pg-text-muted">(not parsed)</span>';

        var hwParts = [];
        if (s.cpu_count)
          hwParts.push(
            esc(s.cpu_count) + ' vCPU' + (s.cpu_count === 1 ? '' : 's'),
          );
        if (s.total_ram) hwParts.push(esc(s.total_ram) + ' RAM');
        if (s.cpu_model)
          hwParts.push(
            '<span class="pg-text-muted">' +
              esc(s.cpu_model) +
              '</span>',
          );
        var hwLine = hwParts.length
          ? hwParts.join(' · ')
          : '<span class="pg-text-muted">(not parsed)</span>';

        // Runtime row: container > VM (named hypervisor) > bare
        // metal. The orchestrator pre-computes ``s.runtime`` from
        // is_container + hypervisor; fall back here if older
        // snapshots don't carry it.
        var runtimeParts = [];
        var runtimeLabel = s.runtime;
        if (!runtimeLabel) {
          if (s.is_container) runtimeLabel = 'container';
          else if (s.hypervisor && s.hypervisor !== 'none')
            runtimeLabel = 'VM (' + s.hypervisor + ')';
          else runtimeLabel = 'bare metal / VM';
        }
        if (s.is_container)
          runtimeParts.push(
            '<span class="pg-chip pg-chip--info">' +
              esc(runtimeLabel) +
              '</span>',
          );
        else runtimeParts.push(esc(runtimeLabel));
        if (s.k8s_namespace)
          runtimeParts.push(
            'k8s namespace <span class="pg-mono">' +
              esc(s.k8s_namespace) +
              '</span>',
          );
        if (s.cloud_provider)
          runtimeParts.push(
            'cloud <span class="pg-mono">' +
              esc(s.cloud_provider) +
              '</span>',
          );
        if (s.host_uptime)
          runtimeParts.push('host uptime ' + esc(s.host_uptime));
        var runtimeLine = runtimeParts.join(' · ');

        // Trim the noisy tail: "PostgreSQL 17.2 (Ubuntu …) on
        // x86_64-pc-linux-gnu, compiled by gcc …, 64-bit" →
        // "PostgreSQL 17.2 (Ubuntu …)". Architecture is already
        // in the Hardware row.
        var pgShort = s.pg_version
          ? s.pg_version.replace(/\s+on\s.*$/i, '')
          : '';
        var pgParts = [];
        if (pgShort) pgParts.push(esc(pgShort));
        if (s.pg_started) pgParts.push('started ' + esc(s.pg_started));
        var pgLine = pgParts.length
          ? pgParts.join(' · ')
          : '<span class="pg-text-muted">(not parsed)</span>';

        // Older radar (< 0.5.0) doesn't write radar.out; surface
        // that explicitly so the operator knows newer rules may
        // be silently skipped on this snapshot.
        var radarLine;
        if (s.radar_version) {
          radarLine =
            '<span class="pg-mono">' + esc(s.radar_version) + '</span>';
          if (s.radar_commit) {
            radarLine +=
              ' <span class="pg-text-muted">(' +
              esc(s.radar_commit) +
              ')</span>';
          }
        } else {
          radarLine =
            '<span class="pg-text-muted">' +
            '(unknown: pre-0.5.0)</span>';
        }

        body.innerHTML =
          '<div class="pg-snapshot__head">' +
          '<h2 class="pg-snapshot__hostname pg-mono">' +
          esc(hostname) +
          '</h2>' +
          '<div class="pg-snapshot__subtitle pg-text-muted">' +
          'uploaded ' +
          esc(uploadedAt) +
          '</div>' +
          '</div>' +
          '<dl class="pg-kv">' +
          row('Host OS', osLine) +
          row('Hardware', hwLine) +
          row('Runtime', runtimeLine) +
          row('PostgreSQL', pgLine) +
          row('Radar', radarLine) +
          '</dl>';
      })
      .catch(function (e) {
        body.innerHTML =
          '<p class="pg-text-muted">Failed to load: ' +
          esc(String(e)) +
          '</p>';
      });
  })();
</script>

<style is:global>
  .pg-snapshot {
    padding: 1.25rem 1.5rem;
  }
  .pg-snapshot__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--pg-divider);
  }
  .pg-snapshot__hostname {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--pg-text);
  }
  .pg-snapshot__subtitle {
    font-size: 0.9rem;
  }

  .pg-kv {
    margin: 0;
    display: grid;
    gap: 0;
  }
  .pg-kv__row {
    display: grid;
    grid-template-columns: minmax(8rem, 10rem) 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--pg-divider);
  }
  .pg-kv__row:last-child {
    border-bottom: 0;
  }
  .pg-kv__label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pg-text-muted);
  }
  .pg-kv__value {
    margin: 0;
    color: var(--pg-text);
    word-break: break-word;
  }
  /* Below 600px the 8-10rem label gutter eats most of the
   * viewport, forcing the value into a 5-char-wide column.
   * Stack label-above-value instead. */
  @media (max-width: 600px) {
    .pg-kv__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding: 0.625rem 0;
    }
  }
</style>
