---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
}
const { title = 'pgEdge Radar Analyst' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/pgedge-favicon.ico" sizes="any" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var STATES = ['system', 'light', 'dark'];
        var mq = window.matchMedia('(prefers-color-scheme: dark)');

        function stored() {
          var s = localStorage.getItem('theme-mode');
          return s === 'light' || s === 'dark' ? s : 'system';
        }
        function resolved(state) {
          return state === 'system'
            ? mq.matches
              ? 'dark'
              : 'light'
            : state;
        }
        function apply() {
          var state = stored();
          document.documentElement.setAttribute(
            'data-theme',
            resolved(state),
          );
          document.dispatchEvent(
            new CustomEvent('pg-theme-change', {
              detail: state,
            }),
          );
        }
        function cycle() {
          var next =
            STATES[(STATES.indexOf(stored()) + 1) % STATES.length];
          if (next === 'system') localStorage.removeItem('theme-mode');
          else localStorage.setItem('theme-mode', next);
          apply();
        }

        window.pgTheme = { stored: stored, cycle: cycle };
        apply();
        if (mq.addEventListener) mq.addEventListener('change', apply);
        else if (mq.addListener) mq.addListener(apply);
        window.addEventListener('storage', function (e) {
          if (e.key === 'theme-mode') apply();
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="pg-main">
      <slot />
    </main>

    <style>
      .pg-main {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }
    </style>
  </body>
</html>
