# Briefs written by a local Ollama server, so no archive content
# leaves the machine.
#
# The model needs roughly 10 GB of VRAM to run fully on GPU. On a
# smaller card it still works, more slowly.

RADAR_ANALYST_AI_PROVIDER=local
RADAR_ANALYST_OLLAMA_HOST=http://host.docker.internal:11434
RADAR_ANALYST_OLLAMA_MODEL=gemma4:e4b

# Concurrent calls to the model. One brief per category plus one per
# active database, so this bounds how hard the pipeline pushes.
RADAR_ANALYST_OLLAMA_CONCURRENCY=3
