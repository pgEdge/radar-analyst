# Settings for `docker compose up -d`. Save this file as `.env`
# beside docker-compose.yml and uncomment what you need. Everything
# here is optional: the compose file supplies the database URL, and
# without a provider credential the findings and verdicts still come
# back, without the written briefs.

# The provider that writes the briefs: claude (the default), gemini,
# openai, or local. Every provider but claude has to be named here.
#RADAR_ANALYST_AI_PROVIDER=claude

# Anthropic.
#ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio.
#RADAR_ANALYST_AI_PROVIDER=gemini
#GOOGLE_API_KEY=...

# OpenAI, or any server that implements the OpenAI chat completions
# API. Such a server needs its own address and model name, and a key
# even when it ignores one. The analyst runs in a container, so
# localhost here would be the container itself.
#RADAR_ANALYST_AI_PROVIDER=openai
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=http://inference.example.com:8000/v1
#OPENAI_MODEL=Qwen/Qwen3-32B

# A local Ollama server, so nothing leaves the machine. The default
# address is an Ollama server on the machine that runs Docker. On
# Docker Engine for Linux, Ollama has to listen on an address that
# containers can reach: it listens on 127.0.0.1 unless its own
# OLLAMA_HOST says otherwise. The analyst does not download models,
# so pull the model on the Ollama server first, for example with
# `ollama pull gemma4:e4b`. The default model, gemma4:e4b, needs
# roughly 10 GB of GPU memory to run entirely on the GPU, and runs
# more slowly on a smaller card.
#RADAR_ANALYST_AI_PROVIDER=local
#RADAR_ANALYST_OLLAMA_HOST=http://host.docker.internal:11434
#RADAR_ANALYST_OLLAMA_MODEL=gemma4:e4b

# The password of the bundled database, applied when its volume is
# first initialized. Any value: the database has no port that
# anything outside the compose project can reach.
#RADAR_ANALYST_DB_PASSWORD=change-me

# Choose the token that authorises deletes yourself, instead of
# reading the generated one out of /data/admin-token.
#RADAR_ANALYST_ADMIN_TOKEN=
