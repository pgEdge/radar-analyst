# docker compose up -d
#
# Save as `.env` beside docker-compose.yml. The compose file supplies
# the database URL, so nothing here is required.

# Provider for the briefs. Omit every credential and the assessment
# still comes back, without the written briefs.
RADAR_ANALYST_AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# Password for the database service. Any value; it is never reachable
# from outside the compose project.
#RADAR_ANALYST_DB_PASSWORD=change-me

# Choose the delete token yourself instead of reading the generated
# one out of /data/admin-token.
#RADAR_ANALYST_ADMIN_TOKEN=
