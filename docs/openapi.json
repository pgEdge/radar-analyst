    "/api/uploads/{upload_id}/assess": {
      "post": {
        "description": "Assess the upload again from its stored archive.\n\nThe previous briefs and findings are removed first, so the\nassessment page never shows two results side by side; the new\nrun replaces the snapshot when it writes one. Refused with 409\nwhile an assessment of the upload is still running.",
        "operationId": "assess_again_route_api_uploads__upload_id__assess_post",
        "parameters": [
          {
            "in": "path",
            "name": "upload_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Upload Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Assess Again Route Api Uploads  Upload Id  Assess Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assess Again Route",
        "tags": [
          "uploads"
        ]
      }
    },
    "/api/uploads/{upload_id}/assessment": {
      "get": {
        "description": "The upload's briefs plus the roll-up verdict over them.\n\nAn upload that hasn't been assessed yet returns an empty brief\nlist and a null verdict rather than a 404, because the console\npolls this while the job is still running.",
