  "info": {
    "description": "Analyzes radar diagnostic zipfiles with deterministic rules plus per-category LLM synthesis.",
    "title": "radar-analyst",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/config": {
      "get": {
        "description": "List the AI providers, with availability and model name.\n\nEach entry carries ``name``, ``label``, ``available`` and\n``model``; an unavailable provider that can explain itself also\ncarries ``reason``.",
        "operationId": "get_config_api_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Config Api Config Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config",
        "tags": [
          "config"
        ]
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "description": "One job's state, phase, timestamps, and error.",
